pkgname=cachysurf
pkgver=0.4.1
pkgrel=1
pkgdesc='Unofficial CachyOS-styled Qt WebEngine browser'
arch=('x86_64')
url='https://github.com/CachyOS'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-webengine' 'qt6-webchannel' 'qtkeychain-qt6' 'hidapi' 'polkit')
makedepends=('cmake' 'ninja')

build() {
  cmake -S "$startdir/.." -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
